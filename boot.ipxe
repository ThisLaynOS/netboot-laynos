#!ipxe

# =========================================================================
# LAYNOS // CLOUD BOOT MENU
# =========================================================================
# Keep the endpoints in one place so mirrors and release versions can be
# updated without changing every menu entry.

set arch x86_64
set menu_timeout 30000
set release_branch main
set project_url https://raw.githubusercontent.com/ThisLaynOS/netboot-laynos/${release_branch}
set project_fallback https://cdn.jsdelivr.net/gh/ThisLaynOS/netboot-laynos@${release_branch}
set arch_base https://geo.mirror.pkgbuild.com/iso/latest
set alpine_base http://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/${arch}/netboot
set alpine_repo http://dl-cdn.alpinelinux.org/alpine/latest-stable/main
set debian_base http://deb.debian.org/debian/dists/stable/main/installer-amd64/current/images/netboot/debian-installer/amd64
set fedora_version 44
set fedora_base https://download.fedoraproject.org/pub/fedora/linux/releases/${fedora_version}/Everything/${arch}/os
set fedora_http http://download.fedoraproject.org/pub/fedora/linux/releases/${fedora_version}/Everything/${arch}/os

isset ${net0/ip} || dhcp || goto network_error

# Paleta RGB Customizada (ANSI 0-7)
colour --rgb 0x10242b 0
colour --rgb 0xf43f5e 1
colour --rgb 0x10b981 2
colour --rgb 0x64748b 3
colour --rgb 0x0ea5e9 4
colour --rgb 0x8b5cf6 5
colour --rgb 0x14b8a6 6
colour --rgb 0xf1f5f9 7

# Pares de Cores da UI (9 = Background Transparente sobre o Card do PNG)
cpair --foreground 7 --background 9 0
cpair --foreground 6 --background 9 1
cpair --foreground 0 --background 6 2
cpair --foreground 3 --background 9 3
cpair --foreground 2 --background 9 4

:init_ui
imgfree
iseq ${platform} efi && goto gui_menu || goto classic_ui

:gui_menu
imgfree
imgfetch --name layncorp_ui.efi ${project_url}/layncorp_ui.efi || imgfetch --name layncorp_ui.efi ${project_fallback}/layncorp_ui.efi || goto classic_ui
set uiret 0
boot layncorp_ui.efi || set uiret ${errno}
iseq ${uiret} 0 && exit 0 ||
iseq ${uiret} 0x7f04828b && goto reboot ||
iseq ${uiret} 0x7f048289 && goto local ||
iseq ${uiret} 0x7f04828a && goto shell ||
iseq ${uiret} 0x7f048281 && set next_target arch && goto prep_console ||
iseq ${uiret} 0x7f048282 && set next_target alpine && goto prep_console ||
iseq ${uiret} 0x7f048283 && set next_target debian && goto prep_console ||
iseq ${uiret} 0x7f048284 && set next_target fedora && goto prep_console ||
iseq ${uiret} 0x7f048285 && set next_target windows && goto prep_console ||
iseq ${uiret} 0x7f048286 && set next_target memtest && goto prep_console ||
iseq ${uiret} 0x7f048287 && set next_target netbootxyz && goto prep_console ||
iseq ${uiret} 0x7f048288 && set next_target sysinfo && goto prep_console ||
goto classic_ui

:prep_console
imgfree
imgfetch --name bg1080 ${project_url}/bg-1080p.png || imgfetch --name bg1080 ${project_fallback}/bg-1080p.png ||
console --x 1920 --y 1080 --left 540 --right 540 --top 275 --bottom 245 --picture bg1080 && goto ${next_target} ||
imgfree
imgfetch --name bg ${project_url}/bg.png || imgfetch --name bg ${project_fallback}/bg.png ||
console --x 1024 --y 768 --left 160 --right 160 --top 140 --bottom 130 --picture bg && goto ${next_target} ||
console && goto ${next_target}

:classic_ui
imgfree
imgfetch --name bg1080 ${project_url}/bg-1080p.png || imgfetch --name bg1080 ${project_fallback}/bg-1080p.png ||
console --x 1920 --y 1080 --left 540 --right 540 --top 275 --bottom 245 --picture bg1080 && goto start ||
imgfree
imgfetch --name bg ${project_url}/bg.png || imgfetch --name bg ${project_fallback}/bg.png ||
console --x 1024 --y 768 --left 160 --right 160 --top 140 --bottom 130 --picture bg && goto start ||
imgfree
imgfetch --name bg https://cdn.jsdelivr.net/gh/ThisLaynOS/netboot-laynos@35e4f57/bg.png ||
console --x 1024 --y 768 --left 160 --right 160 --top 140 --bottom 130 --picture bg || console --x 1024 --y 768 --left 160 --right 160 --top 140 --bottom 130 || console

:start
menu LAYNOS CLOUD BOOT  //  IP: ${net0/ip}  //  MAC: ${net0/mac}
item --gap --
item --gap --   OPERATING SYSTEMS -----------------------------------------
item --key 1 arch        1  Arch Linux               Rolling  | Live Installer
item --key 2 alpine      2  Alpine Linux             Stable   | RAM Rootfs
item --key 3 debian      3  Debian GNU/Linux         Stable   | Network Installer
item --key 4 fedora      4  Fedora Linux             ${fedora_version}       | Network Installer
item --key 5 windows     5  Windows 10/11            Setup    | Sem Pendrive
item --gap --
item --gap --   TOOLS & RECOVERY ------------------------------------------
item --key 6 memtest     6  Memtest86+ UEFI          Latest   | Memory Test
item --key 7 netbootxyz  7  netboot.xyz Hub          Online   | ISO Library
item --gap --
item --gap --   SYSTEM -----------------------------------------------------
item --key i sysinfo     I  Hardware & Network Information
item --key s shell       S  iPXE Command Line Interface
item --key r reboot      R  Reboot
item --key x local       X  Boot Local Disk (NVMe / SATA)
item --key q exit        Q  Exit to Firmware

choose --default exit --timeout ${menu_timeout} target && goto ${target} || goto exit

# =========================================================================
# BOOT TARGETS
# =========================================================================

:arch
echo
echo  [LAYNOS CLOUD] Inicializando Arch Linux (${arch})...
echo  ================================================================
imgfree
echo  [+] Baixando Kernel (vmlinuz-linux)...
kernel ${arch_base}/arch/boot/${arch}/vmlinuz-linux initrd=initramfs-linux.img archiso_http_srv=${arch_base}/ archisobasedir=arch cms_verify=y ip=dhcp net.ifnames=0 || goto error
echo  [+] Baixando Initramfs (initramfs-linux.img)...
initrd ${arch_base}/arch/boot/${arch}/initramfs-linux.img || goto error
echo  [+] Executando boot UEFI...
boot || goto error
goto init_ui

:alpine
echo
echo  [LAYNOS CLOUD] Inicializando Alpine Linux (RAM Disk)...
echo  ================================================================
imgfree
echo  [+] Baixando Kernel (vmlinuz-lts)...
kernel ${alpine_base}/vmlinuz-lts initrd=initramfs-lts modules=loop,squashfs,sd-mod,usb-storage,r8169 modloop=${alpine_base}/modloop-lts alpine_repo=${alpine_repo} ip=dhcp || goto error
echo  [+] Baixando Initramfs (initramfs-lts)...
initrd ${alpine_base}/initramfs-lts || goto error
echo  [+] Executando boot UEFI...
boot || goto error
goto init_ui

:debian
echo
echo  [LAYNOS CLOUD] Inicializando Debian Stable Netboot (amd64)...
echo  ================================================================
imgfree
echo  [+] Baixando Kernel Debian...
kernel ${debian_base}/linux initrd=initrd.gz --- quiet || goto error
echo  [+] Baixando Initrd...
initrd ${debian_base}/initrd.gz || goto error
echo  [+] Executando boot UEFI...
boot || goto error
goto init_ui

:fedora
echo
echo  [LAYNOS CLOUD] Inicializando Fedora ${fedora_version} Netinstall...
echo  ================================================================
imgfree
echo  [+] Baixando Kernel (vmlinuz)...
kernel ${fedora_base}/images/pxeboot/vmlinuz initrd=initrd.img inst.stage2=${fedora_base} ip=dhcp || kernel ${fedora_http}/images/pxeboot/vmlinuz initrd=initrd.img inst.stage2=${fedora_http} ip=dhcp || goto error
echo  [+] Baixando Initrd (initrd.img)...
initrd ${fedora_base}/images/pxeboot/initrd.img || initrd ${fedora_http}/images/pxeboot/initrd.img || goto error
echo  [+] Executando boot UEFI...
boot || goto error
goto init_ui

:windows
echo
echo  [LAYNOS CLOUD] Instalacao Windows via Rede (Sem Pendrive)
echo  ================================================================
echo  [+] Este slot sera conectado ao wimboot + WinPE / servidor SMB.
echo  [+] Retornando ao menu grafico em 3 segundos...
sleep 3
goto init_ui

:memtest
echo
echo  [LAYNOS CLOUD] Carregando Memtest86+ (UEFI x86_64)...
echo  ================================================================
imgfree
kernel https://github.com/netbootxyz/asset-mirror/releases/download/9.00-3c42ace6/mt86p_x86_64 || goto error
boot || goto error
goto init_ui

:netbootxyz
echo
echo  [LAYNOS CLOUD] Encadeando suite completa netboot.xyz...
echo  ================================================================
imgfree
chain --autofree https://boot.netboot.xyz/ipxe/netboot.xyz.efi || goto error
goto init_ui

:sysinfo
menu LAYNOS SYSTEM INFORMATION
item --gap --
item --gap --   NETWORK ---------------------------------------------------
item --gap --   MAC Address      : ${net0/mac}
item --gap --   IPv4 Address     : ${net0/ip}
item --gap --   Subnet Mask      : ${net0/netmask}
item --gap --   Default Gateway  : ${net0/gateway}
item --gap --   DNS Server       : ${dns}
item --gap --
item --gap --   PLATFORM --------------------------------------------------
item --gap --   Platform         : ${platform}
item --gap --   Build Architecture: ${buildarch}
item --gap --   System UUID      : ${uuid}
item --gap --
item --key b back  B  Voltar ao Menu Principal
choose --default back target && goto init_ui || goto init_ui

:shell
console --x 1920 --y 1080 --left 64 --right 64 --top 64 --bottom 64 || console --x 1024 --y 768 --left 48 --right 48 --top 48 --bottom 48 ||
echo
echo  LAYNOS iPXE Shell | Digite 'exit' para retornar a interface grafica.
echo  ======================================================================
shell
goto init_ui

:reboot
reboot

:local
echo
echo  [LAYNOS] Inicializando o disco local via firmware...
echo  ================================================================
iseq ${platform} pcbios && sanboot --no-describe --drive 0x80 ||
exit 0

:exit
exit 0

:network_error
echo
echo  [!] Nenhuma interface de rede configurada.
echo  Verifique o cabo, DHCP ou a configuracao da rede.
prompt
goto init_ui

:error
echo
echo  [!] Falha ao carregar o alvo selecionado.
echo  Verifique a conectividade e tente novamente.
prompt
goto init_ui
